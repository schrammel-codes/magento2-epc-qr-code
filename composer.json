{
    "name": "schrammel-codes/magento2-epc-qr-code",
    "description": "This modules enables merchants to provide an EPC QR code for banktransfer payments to customers",
    "type": "magento2-module",
    "license": [
        "MIT"
    ],
    "version": "2.1.0",
    "require": {
        "php": "^8.1",
        "magento/framework": "^103",
        "magento/module-sales": "^103",
        "smhg/sepa-qr-data": "^2",
        "apirone/php-qr-code": "^1"
    },
    "authors": [
        {
            "name": "Dipl.-Ing. Andreas Schrammel, BSc.",
            "email": "andreas@schrammel.codes",
            "role": "lead"
        }
    ],
    "support": {
        "source": "https://github.com/schrammel-codes/magento2-epc-qr-code",
        "issues": "https://github.com/schrammel-codes/magento2-epc-qr-code/issues"
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://repo.magento.com/"
        }
    ],
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "SchrammelCodes\\EpcQrCode\\": ""
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.0"
    },
    "scripts": {
        "test": "vendor/bin/phpunit"
    },
    "config": {
        "allow-plugins": {
            "magento/composer-dependency-version-audit-plugin": true
        }
    }
}
